{
  "name": "@mrdoge/node",
  "version": "0.1.1",
  "description": "Mr. Doge Node SDK — server-side WebSocket + HTTP client. Authenticate with an `sk_live_...` API key and stream live sports data.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mrdogeco/sdk/tree/main/packages/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdogeco/sdk.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/mrdogeco/sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "echo 'TODO: vitest'",
    "lint": "echo 'TODO: eslint'",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish --access public --no-git-checks",
    "release:dry": "pnpm publish --access public --dry-run --no-git-checks"
  },
  "keywords": [
    "mrdoge",
    "sports",
    "odds",
    "betting",
    "realtime",
    "websocket",
    "sdk"
  ],
  "dependencies": {
    "@mrdoge/http": "workspace:*",
    "@mrdoge/protocol": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
