{
  "name": "@mrdoge/client",
  "version": "0.2.0",
  "description": "Mr. Doge client SDK for browsers, React Native, and edge runtimes. Authenticates via a customer-minted JWT — never embeds the API key.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mrdogeco/sdk/tree/main/packages/client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdogeco/sdk.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/mrdogeco/sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "echo 'TODO: vitest'",
    "lint": "echo 'TODO: eslint'",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish --access public --no-git-checks",
    "release:dry": "pnpm publish --access public --dry-run --no-git-checks"
  },
  "keywords": [
    "mrdoge",
    "sports",
    "odds",
    "betting",
    "realtime",
    "websocket",
    "sdk",
    "browser",
    "react-native"
  ],
  "dependencies": {
    "@mrdoge/http": "workspace:*",
    "@mrdoge/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  }
}
