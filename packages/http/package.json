{
  "name": "@mrdoge/http",
  "version": "0.2.0",
  "description": "Mr. Doge HTTP-only SDK. Zero runtime deps beyond @mrdoge/protocol. Works anywhere fetch exists: Node, browsers, React Native, Cloudflare Workers, Vercel Edge, Lambda.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mrdogeco/sdk/tree/main/packages/http",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdogeco/sdk.git",
    "directory": "packages/http"
  },
  "bugs": {
    "url": "https://github.com/mrdogeco/sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "echo 'TODO: vitest'",
    "lint": "echo 'TODO: eslint'",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish --access public --no-git-checks",
    "release:dry": "pnpm publish --access public --dry-run --no-git-checks"
  },
  "keywords": [
    "mrdoge",
    "sports",
    "odds",
    "betting",
    "http",
    "rpc",
    "sdk",
    "edge"
  ],
  "dependencies": {
    "@mrdoge/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  }
}
