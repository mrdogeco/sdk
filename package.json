{
  "name": "mrdoge-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Mr. Doge open-source SDKs and protocol",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mrdoge/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdoge/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mrdoge/sdk/issues"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r --filter=./packages/* test",
    "lint": "pnpm -r --filter=./packages/* lint",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "version:patch": "pnpm -r --filter=./packages/* exec npm version patch --no-git-tag-version",
    "version:minor": "pnpm -r --filter=./packages/* exec npm version minor --no-git-tag-version",
    "version:major": "pnpm -r --filter=./packages/* exec npm version major --no-git-tag-version",
    "release:protocol": "pnpm build && pnpm --filter @mrdoge/protocol release",
    "release:node": "pnpm build && pnpm --filter @mrdoge/sdk release",
    "release:client": "pnpm build && pnpm --filter @mrdoge/client release",
    "release:all": "pnpm release:protocol && pnpm --filter @mrdoge/sdk release && pnpm --filter @mrdoge/client release",
    "release:protocol:dry": "pnpm build && pnpm --filter @mrdoge/protocol release:dry",
    "release:node:dry": "pnpm build && pnpm --filter @mrdoge/sdk release:dry",
    "release:client:dry": "pnpm build && pnpm --filter @mrdoge/client release:dry",
    "release:all:dry": "pnpm release:protocol:dry && pnpm --filter @mrdoge/sdk release:dry && pnpm --filter @mrdoge/client release:dry"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
